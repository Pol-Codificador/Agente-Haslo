# ============================================================================
# CONFIGURACIÓN DEL VORTEX AI DESKTOP
# ============================================================================

# 1. Google Gemini API (Obtén tu clave en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite-preview
GEMINI_MODELS_COMPLEX=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-pro-preview,gemini-3.5-flash-lite,gemini-4-hydrogen

# 2. Universidad Nacional de San Agustín - DUTIC (Moodle) y Perfil Institucional
# Correo institucional (opcional, usado como contexto de perfil UNSA)
INSTITUTIONAL_EMAIL=tu_correo@unsa.edu.pe
# En Aula Virtual -> Calendario -> Exportar calendario -> "Todos los eventos" -> "Eventos próximos" -> Obtener URL
DUTIC_ICAL_URL=

# 3. Seguridad de WhatsApp (Tu número con código de país sin '+' ni espacios, ej: 51987654321)
ALLOWED_PHONE_NUMBER=519XXXXXXXX
# Prefijo opcional para activar el bot (ej: ! o /bot). Déjalo vacío para hablar directo en tu chat personal.
BOT_PREFIX=

# 4. Google Calendar
# Usa 'primary' para el calendario principal de tu cuenta autenticada, o el correo de tu calendario compartido
GOOGLE_CALENDAR_ID=primary

# 5. Servidor Local Python y Notificador WhatsApp
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
WHATSAPP_NOTIFY_PORT=8001
